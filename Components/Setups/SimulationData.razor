@page "/SimulationData/{SimulationId:guid}"
@using System.Text.Json
@using System.Text.Json.Serialization;
@using CPT.Models.SimulationResults
@using CPT.Services
@using cpt.Components.Shared
@using cpt.Components.Visualization
@using cpt.Models.Simulations;
@using cpt.Models.HeatEquation
@using System.Globalization
@using System.Text
@using Microsoft.JSInterop
@using System.IO

@inject UserSettingsApiService UserSettingsApi
@inject IJSRuntime JS
@inject HeatEquationApiService HeatEquationApi
@inject NavigationManager Nav

<ProtectedRouteView AllowAnonymous="@Demo">
    <div class="hx-1 wvl-5"></div>

    @* <div class="mgb-5 flex flex-center flex-spacebetween bg-primary-02 bd pd border-shadow-5">
    <div>
        <h2 class="mg-0 pdb fsz-18 cl-primary">Simulation Data</h2>
        <p class="mg-0 fsz-10">Exports and download your results</p>
    </div>
    <button class="bg-primary pd fsz-10 corner-2 bd-none wx-15 flex flex-center shadow-border-2" @onclick="ViewResults">
        <i class="mdi mdi-plus fsz-10 mgr-5"></i>
        View Results
    </button>
</div> *@

    <div class="bg-card">
        <div class="mgb-5 flex flex-center flex-spacebetween flow bg-primary-02 bd pd border-shadow-5">

            <div class="mgb-5">
                <div class="flex flex-center">

                    <button class="bg-transparent bd-none fsz-15 mgr-2" @onclick="GoBack" title="Go back">
                        <i class="mdi mdi-arrow-left round bd cl-primary bg-card pd fw-bold"></i>
                    </button>

                    <div>
                        <h2 class="mg-0 pdb fsz-18 cl-primary">
                            Simulation Data
                        </h2>

                        <p class="mg-0 fsz-10">
                            Exports and download your results
                        </p>
                    </div>

                </div>
            </div>

            @if (Demo)
            {
                <button class="bg-transparent pd fsz-10 corner-2 bd wx-15 flex flex-center shadow-border-2 mgr-3"
                        @onclick="ExitDemo">

                    <i class="mdi mdi-exit-to-app fsz-10 mgr-5"></i>
                    Exit Demo

                </button>
            }
            <button class="bg-primary pd fsz-10 corner-2 bd-none wx-15 flex flex-center shadow-border-2"
                    @onclick="ViewResults">

                <i class="mdi mdi-plus fsz-10 mgr-5"></i>
                View Results

            </button>

        </div>
    </div>

    <div class="mgb scroll wf">
        <button class="fsz-10 bd-none bdb pd mgb-1 mgr-1 @(ActiveTab == "Data Table" ? "bg-primary" : "bg-primary-02")"
                @onclick='() => SetActiveTab("Data Table")'>
            Data Table
        </button>

        <button
            class="fsz-10 bd-none bdb pd bg-transparent mgb-1 mgr-1 @(ActiveTab == "Statistics" ? "bg-primary" : "bg-primary-02")"
            @onclick='() => SetActiveTab("Statistics")'>
            Statistics
        </button>

        @if (!Demo)
        {
            <button
                class="fsz-10 bd-none bdb pd bg-transparent mgb-1 mgr-1 @(ActiveTab == "Export" ? "bg-primary" : "bg-primary-02")"
                @onclick='() => SetActiveTab("Export")'>
                Export
            </button>
        }
    </div>

    <div>
        @if (IsLoading)
        {
            <div class="hf bg-card pd bd corner-2 flex flex-center justify-content-between">
                <LoadingIndicator Text="Loading simulation data..." />
            </div>
        }
        else if (HasError)
        {
            <div class="hf bg-card pd bd corner-2 flex flex-center justify-content-between">
                <p class="fsz-15 fw-bold">Unable to load simulation results.</p>
            </div>
        }
        else if (Data is null)
        {
            <div class="hf bg-card pd bd corner-2 flex flex-center justify-content-between">
                <p class="fsz-15 fw-bold">No simulation result was found.</p>
            </div>
        }
        else
        {
            @if (ActiveTab == "Data Table")
            {
                <div class="row responsive colm-3">
                    <div class="miwx-25">

                        <div class="wf hx-6 scroll-y">
                            <table class="wf scroll bg-card pd bd corner-2">
                                <thead class="bg-primary-02">
                                    <tr class="mg-0">
                                        <th class="pd mg-0 fsz-12">x</th>
                                        <th class="pd fsz-12">y</th>
                                        <th class="pd fsz-12">Temperature</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var point in PagedPoints)
                                    {
                                        <tr>
                                            <td class="pd fsz-12 text-center bd-none bdb bdb-primary">
                                                @FormatNumber(point.X, 3)
                                            </td>

                                            <td class="pd fsz-12 text-center bd-none bdb bdb-primary">
                                                @FormatNumber(point.Y, 3)
                                            </td>

                                            <td class="pd fsz-12 text-center bd-none bdb bdb-primary">
                                                @FormatNumber(point.Temperature, 6)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="flex flex-spacebetween flow bg-card pd bd corner-1 shadow-border-1 mgb mgt-2">

                            <p class="fsz-12 mgb-3">
                                Showing @StartItem–@EndItem of @TotalPoints grid points
                            </p>

                            <div class="flex flex-center">

                                <button class="mdi mdi-arrow-left pd fsz-12 bg-transparent bd-none bd corner-1"
                                        disabled="@(CurrentPage == 1)" @onclick="PreviousPage">
                                </button>

                                @if (TotalPages <= 5)
                                {
                                    @for (int page = 1; page <= TotalPages; page++)
                                    {
                                        var pageNumber = page;

                                        <button
                                            class="mdi pd fsz-12 bg-transparent bd-none bd corner-1 @(CurrentPage == pageNumber ? "bg-primary" : "")"
                                            @onclick="() => GoToPage(pageNumber)">
                                            @pageNumber
                                        </button>
                                    }
                                }
                                else
                                {
                                    <button
                                        class="mdi pd fsz-12 bg-transparent bd-none bd corner-1 @(CurrentPage == 1 ? "bg-primary" : "")"
                                        @onclick="() => GoToPage(1)">
                                        1
                                    </button>

                                    @if (CurrentPage > 3)
                                    {
                                        <span class="pd fsz-12">...</span>
                                    }

                                    @if (CurrentPage > 2 && CurrentPage < TotalPages - 1)
                                    {
                                        <button class="mdi pd fsz-12 bg-transparent bd-none bd corner-1"
                                                @onclick="() => GoToPage(CurrentPage - 1)">
                                            @(CurrentPage - 1)
                                        </button>
                                    }

                                    @if (CurrentPage != 1 && CurrentPage != TotalPages)
                                    {
                                        <button class="mdi pd fsz-12 bg-transparent bd-none bd corner-1 bg-primary"
                                                @onclick="() => GoToPage(CurrentPage)">
                                            @CurrentPage
                                        </button>
                                    }

                                    @if (CurrentPage > 1 && CurrentPage < TotalPages - 1)
                                    {
                                        <button class="mdi pd fsz-12 bg-transparent bd-none bd corner-1"
                                                @onclick="() => GoToPage(CurrentPage + 1)">
                                            @(CurrentPage + 1)
                                        </button>
                                    }

                                    @if (CurrentPage < TotalPages - 2)
                                    {
                                        <span class="pd fsz-12">...</span>
                                    }

                                    <button
                                        class="mdi pd fsz-12 bg-transparent bd-none bd corner-1 @(CurrentPage == TotalPages ? "bg-primary" : "")"
                                        @onclick="() => GoToPage(TotalPages)">
                                        @TotalPages
                                    </button>
                                }

                                <button class="mdi mdi-arrow-right pd fsz-12 bg-transparent bd-none bd corner-1"
                                        disabled="@(CurrentPage == TotalPages)" @onclick="NextPage">
                                </button>

                            </div>
                        </div>

                    </div>
                </div>
            }
            else if (ActiveTab == "Statistics")
            {
                <div class="row responsive colm-3 wvg-5 scroll-y" style="height: 100vh;">
                    <div class="miwx-25 mgr-10">
                        <div class="bg-card bd corner-1 pd">
                            <h5 class="mgt-0 mgl-0 mgr-0 mgb-10 pdb fsz-15 cl-primary bdb bd-primary">
                                Statistics
                            </h5>
                            <div class="grid gap-1 colm-3">

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">
                                        Minimum Temperature
                                    </p>

                                    <h4 class="mg-0 fsz-15 cl-secondary">
                                        @FormatNumber(Statistics.Minimum, 6) K
                                    </h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">
                                        Maximum Temperature
                                    </p>

                                    <h4 class="mg-0 fsz-15 cl-secondary">
                                        @FormatNumber(Statistics.Maximum, 6) K
                                    </h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">
                                        Average Temperature
                                    </p>

                                    <h4 class="mg-0 fsz-15 cl-secondary">
                                        @FormatNumber(Statistics.Mean, 6) K
                                    </h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">
                                        Standard Deviation
                                    </p>

                                    <h4 class="mg-0 fsz-15 cl-secondary">
                                        @FormatNumber(Statistics.StandardDeviation, 6) K
                                    </h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">
                                        Final Simulation Time
                                    </p>

                                    <h4 class="mg-0 fsz-15 cl-secondary">
                                        @FormatNumber(Data.FinalTime, 4) s
                                    </h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">
                                        Grid Points
                                    </p>

                                    <h4 class="mg-0 fsz-15 cl-secondary">
                                        @TotalPoints
                                    </h4>
                                </div>

                            </div>
                        </div>

                        <div class="mgt-5 corner-2 bd pd bg-card">

                            <h5 class="mg-0 pdb fsz-15 cl-primary">
                                Boundary Conditions
                            </h5>

                            <p class="mg-0 fsz-10 bdb bd-primary pdb">
                                Temperature constraints applied at the simulation boundaries
                            </p>

                            <div class="grid gap-1 colm-3 mgt-10">

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">
                                        Boundary Type
                                    </span>

                                    <div class="mgt-5 fw-600 cl-secondary">
                                        @Data.BoundaryConditionType
                                    </div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">
                                        Boundary Temperature
                                    </span>

                                    <div class="mgt-5 fw-600 cl-secondary">
                                        @FormatNumber(BoundaryTemperature, 2) K
                                    </div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">
                                        Top Boundary
                                    </span>

                                    <div class="mgt-5 fw-600 cl-secondary">
                                        @Data.TopBoundaryCondition
                                    </div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">
                                        Bottom Boundary
                                    </span>

                                    <div class="mgt-5 fw-600 cl-secondary">
                                        @Data.BottomBoundaryCondition
                                    </div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">
                                        Left Boundary
                                    </span>

                                    <div class="mgt-5 fw-600 cl-secondary">
                                        @Data.LeftBoundaryCondition
                                    </div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">
                                        Right Boundary
                                    </span>

                                    <div class="mgt-5 fw-600 cl-secondary">
                                        @Data.RightBoundaryCondition
                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                </div>

            
                <div class="row responsive colm-3 wvl-5 scroll-y" style="height: 100vh">
                    <div class="miwx-25">
                        <div class="bg-card bd corner-1 pd">
                            <h5 class="mgt-0 mgl-0 mgr-0 mgb-10 pdb fsz-15 cl-primary bdb bd-primary">
                                Statistics
                            </h5>
                            <div class="grid gap-1 colm-3">

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">
                                        Minimum Temperature
                                    </p>

                                    <h4 class="mg-0 fsz-15 cl-secondary">
                                        @Statistics.Minimum.ToString("F6") K
                                    </h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">
                                        Maximum Temperature
                                    </p>

                                    <h4 class="mg-0 fsz-15 cl-secondary">
                                        @Statistics.Maximum.ToString("F6") K
                                    </h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">
                                        Average Temperature
                                    </p>

                                    <h4 class="mg-0 fsz-15 cl-secondary">
                                        @Statistics.Mean.ToString("F6") K
                                    </h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">
                                        Standard Deviation
                                    </p>

                                    <h4 class="mg-0 fsz-15 cl-secondary">
                                        @Statistics.StandardDeviation.ToString("F6") K
                                    </h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">
                                        Final Simulation Time
                                    </p>

                                    <h4 class="mg-0 fsz-15 cl-secondary">
                                        @Data.FinalTime.ToString("F4") s
                                    </h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">
                                        Grid Points
                                    </p>

                                    <h4 class="mg-0 fsz-15 cl-secondary">
                                        @TotalPoints
                                    </h4>
                                </div>

                            </div>
                        </div>

                        <div class="mgt-5 corner-2 bd pd bg-card">

                            <h5 class="mg-0 pdb fsz-15 cl-primary">
                                Boundary Conditions
                            </h5>

                            <p class="mg-0 fsz-10 bdb bd-primary pdb">
                                Temperature constraints applied at the simulation boundaries
                            </p>

                            <div class="grid gap-1 colm-3 mgt-10">

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3">
                                    <span class="fsz-10">
                                        Boundary Type
                                    </span>

                                    <div class="mgt-5 fw-600 cl-secondary">
                                        @Data.BoundaryConditionType
                                    </div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3">
                                    <span class="fsz-10">
                                        Boundary Temperature
                                    </span>

                                    <div class="mgt-5 fw-600 cl-secondary">
                                        @BoundaryTemperature.ToString("F2") K
                                    </div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3">
                                    <span class="fsz-10">
                                        Top Boundary
                                    </span>

                                    <div class="mgt-5 fw-600 cl-secondary">
                                        @Data.TopBoundaryCondition
                                    </div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3">
                                    <span class="fsz-10">
                                        Bottom Boundary
                                    </span>

                                    <div class="mgt-5 fw-600 cl-secondary">
                                        @Data.BottomBoundaryCondition
                                    </div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3">
                                    <span class="fsz-10">
                                        Left Boundary
                                    </span>

                                    <div class="mgt-5 fw-600 cl-secondary">
                                        @Data.LeftBoundaryCondition
                                    </div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3">
                                    <span class="fsz-10">
                                        Right Boundary
                                    </span>

                                    <div class="mgt-5 fw-600 cl-secondary">
