            csv.AppendLine($"Minimum Temperature,{Statistics.Minimum.ToString(CultureInfo.InvariantCulture)}");
            csv.AppendLine($"Maximum Temperature,{Statistics.Maximum.ToString(CultureInfo.InvariantCulture)}");
            csv.AppendLine($"Average Temperature,{Statistics.Mean.ToString(CultureInfo.InvariantCulture)}");
            csv.AppendLine($"Standard Deviation,{Statistics.StandardDeviation.ToString(CultureInfo.InvariantCulture)}");
            csv.AppendLine($"Grid Points,{TotalPoints}");
