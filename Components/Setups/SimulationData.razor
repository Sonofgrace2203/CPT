        }
        <div class="hx-06 wvl-5"></div>
    </div>

    @if (ShowDemoComplete)
    {
        <DemoComplete CreateAccount="GoToCreateAccount" CreateLater="HideDemoComplete" />
    }

    @if (ShowExitDemoDialog)
    {
        <ConfirmDialog IsVisible="@ShowExitDemoDialog" Title="Exit Demo" Message="Are you sure you want to exit the demo?"
                       ConfirmText="Exit Demo" CancelText="Cancel" Icon="mdi-exit-to-app" OnConfirm="ConfirmExitDemo"
                       OnCancel="CancelExitDemo" />
    }
</ProtectedRouteView>

@code {
    [Parameter] public Guid SimulationId { get; set; }

    private SimulationResultDto? Result;
    private HeatEquationResultData? Data;
    private SimulationDto? Simulation;

    private SimulationStatistics Statistics { get; set; } = new();

    private bool IsLoading = true;
    private bool HasError = false;

    private const int PageSize = 20;
    private int CurrentPage = 1;
    private int TotalPoints => Data?.Temperature?.Sum(row => row?.Length ?? 0) ?? 0;
    private int TotalPages => TotalPoints == 0 ? 1 : (int)Math.Ceiling(TotalPoints / (double)PageSize);

    private double BoundaryTemperature => Data?.BoundaryTemperature ?? 0;

    private int StartItem => TotalPoints == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int EndItem => Math.Min(CurrentPage * PageSize, TotalPoints);

    private string ActiveTab { get; set; } = "Data Table";
    private string NumberFormat { get; set; } = "decimal";

    private string ExportFormat { get; set; } = "CSV";

    private bool IncludeParameters { get; set; } = true;

    private bool IncludeGridData { get; set; } = true;

    private bool IncludeStatistics { get; set; } = true;

    private bool IncludeMetadata { get; set; } = true;

    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }

    [SupplyParameterFromQuery(Name = "demo")]
    public bool Demo { get; set; }
    private bool ShowDemoComplete { get; set; }
    private bool ShowExitDemoDialog { get; set; }

    [SupplyParameterFromQuery(Name = "colorMap")] public string? ColorMap { get; set; }

    private string SelectedColorMapName =>
    ColorMap is "Viridis" or "Grayscale"
        ? ColorMap
        : "Thermal";

    private void GoToCreateAccount()
    {
        Nav.NavigateTo("SignUp");
    }

    private void HideDemoComplete()
    {
        ShowDemoComplete = false;
    }

    private void ExitDemo()
    {
        ShowExitDemoDialog = true;
    }

    private void ConfirmExitDemo()
    {
        ShowExitDemoDialog = false;
        Nav.NavigateTo("/");
    }

    private void CancelExitDemo()
    {
        ShowExitDemoDialog = false;
    }

    private void GoBack()
    {
        if (From == "demo-history")
        {
            Nav.NavigateTo("/Admin/DemoHistory");
            return;
        }

        if (From == "history")
        {
            Nav.NavigateTo("/SimulationHistory");
            return;
        }

        Nav.NavigateTo($"/HeatEquation/Simulate/{SimulationId}");
    }

    private void SetActiveTab(string tab)
    {
        ActiveTab = tab;
    }



    private async Task DownloadData()
    {
        if (Demo || Data is null)
            return;

        if (ExportFormat == "CSV")
        {
            var csv = GenerateCsv();

            await JS.InvokeVoidAsync(
                "cptDownloadFile",
                GetDownloadFileName("csv"),
                "text/csv;charset=utf-8",
                csv);

            return;
        }

        if (ExportFormat == "PDF")
        {
            var pdfContent = GeneratePdfContent();

            var gridData = IncludeGridData
                ? AllPoints.Select(point => new
                {
                    x = point.X,
                    y = point.Y,
                    temperature = point.Temperature
                }).ToArray()
                : Array.Empty<object>();

            await JS.InvokeVoidAsync(
                "cptDownloadPdf",
                GetDownloadFileName("pdf"),
                pdfContent,
                Data.Temperature,
                Data.GridWidth,
                Data.GridHeight,
                Statistics.Minimum,
                Statistics.Maximum,
                gridData,
                IncludeGridData,
                SelectedColorMapName);

            return;
        }

        if (ExportFormat == "PNG")
        {
            var reportContent = GeneratePdfContent();

            var gridData = IncludeGridData
                ? AllPoints.Select(point => new
                {
                    x = point.X,
                    y = point.Y,
                    temperature = point.Temperature
                }).ToArray()
                : Array.Empty<object>();

            await JS.InvokeVoidAsync(
                "cptDownloadHeatmapPng",
                GetDownloadFileName("png"),
                reportContent,
                Data.Temperature,
                Data.GridWidth,
                Data.GridHeight,
                Statistics.Minimum,
                Statistics.Maximum,
                gridData,
                IncludeGridData,
                SelectedColorMapName);

            return;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!Demo && Tab?.Equals("export", StringComparison.OrdinalIgnoreCase) == true)
        {
            ActiveTab = "Export";
        }

        try
        {
            var settings = await UserSettingsApi.GetAsync();

            if (settings is not null)
            {
                NumberFormat = settings.NumberFormat;
            }

            Result = await HeatEquationApi.GetLatestResultAsync(SimulationId);
            Simulation = await HeatEquationApi.GetSimulationAsync(SimulationId);

            if (Result?.ResultData is not null)
            {
                Data = JsonSerializer.Deserialize<HeatEquationResultData>(
                    Result.ResultData,
                    new JsonSerializerOptions
                    {
                        PropertyNameCaseInsensitive = true
                    });

                if (Data is not null)
                {
                    CalculateStatistics();
                }
            }
        }
        catch
        {
            HasError = true;
        }
        finally
        {
            IsLoading = false;

            if (Demo && Data is not null)
            {
                ShowDemoComplete = true;
            }
        }
    }

    private string FormatNumber(
    double value,
    int decimalPlaces = 6)
    {
        if (NumberFormat.Equals(
            "integer",
            StringComparison.OrdinalIgnoreCase))
        {
            return Math.Round(value)
                .ToString("0", CultureInfo.InvariantCulture);
        }

        return value.ToString(
            $"F{decimalPlaces}",
            CultureInfo.InvariantCulture);
    }

    private class GridPoint
    {
        public double X { get; set; }
        public double Y { get; set; }
        public double Temperature { get; set; }
    }

    private IEnumerable<GridPoint> AllPoints
    {
        get
        {
            if (Data is null)
                return [];

            var points = new List<GridPoint>();

            for (int y = 0; y < Data.Temperature.Length; y++)
            {
                var row = Data.Temperature[y];

                if (row is null)
                    continue;

                for (int x = 0; x < row.Length; x++)
                {
                    var xCoordinate =
                        -1.0 +
                        (2.0 * x / (Data.GridWidth - 1));

                    var yCoordinate =
                        -1.0 +
                        (2.0 * y / (Data.GridHeight - 1));

                    points.Add(new GridPoint
                    {
                        X = xCoordinate,
                        Y = yCoordinate,
                        Temperature = row[x]
                    });
                }
            }

            return points;
        }
    }

    private IEnumerable<GridPoint> PagedPoints => AllPoints.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }

    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }

    private void GoToPage(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

