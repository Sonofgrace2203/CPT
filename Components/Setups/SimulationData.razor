    private class SimulationStatistics
    {
        public double Minimum { get; set; }
        public double Maximum { get; set; }
        public double Mean { get; set; }
        public double StandardDeviation { get; set; }
    }

    private void CalculateStatistics()
    {
        if (Data?.Temperature is null)
            return;

        var values = Data.Temperature
            .Where(row => row is not null)
            .SelectMany(row => row!)
            .ToList();

        if (values.Count == 0)
            return;

        var mean = values.Average();

        var variance = values
            .Select(value => Math.Pow(value - mean, 2))
            .Average();

        Statistics = new SimulationStatistics
        {
            Minimum = values.Min(),
            Maximum = values.Max(),
            Mean = mean,
            StandardDeviation = Math.Sqrt(variance)
        };
    }

    private void ViewResults()
    {
        if (Demo)
        {
            Nav.NavigateTo(
                $"/Result/{SimulationId}?demo=true");
            return;
        }

        if (From == "demo-history")
        {
            Nav.NavigateTo(
                $"/Result/{SimulationId}?from=demo-history");
            return;
        }

        if (From == "history")
        {
            Nav.NavigateTo(
                $"/Result/{SimulationId}?from=history");
            return;
        }

        Nav.NavigateTo(
            $"/Result/{SimulationId}");
    }

    private string GetDownloadFileName(string extension)
    {
        var name = Simulation?.Name;

        if (string.IsNullOrWhiteSpace(name))
            name = "CPT Heat Equation Simulation";

        foreach (var invalidChar in Path.GetInvalidFileNameChars())
        {
            name = name.Replace(invalidChar, '-');
        }

        return $"{name}.{extension}";
    }
