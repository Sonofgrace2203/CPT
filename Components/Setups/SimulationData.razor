            csv.AppendLine();
        }

        if (IncludeParameters)
        {
            csv.AppendLine("PARAMETERS");
            csv.AppendLine($"Grid Width,{Data!.GridWidth}");
            csv.AppendLine($"Grid Height,{Data.GridHeight}");
            csv.AppendLine($"Final Time,{Data.FinalTime.ToString(CultureInfo.InvariantCulture)}");
            csv.AppendLine($"Boundary Condition Type,{Data.BoundaryConditionType}");
            csv.AppendLine($"Boundary Temperature,{Data.BoundaryTemperature.ToString(CultureInfo.InvariantCulture)}");
