@page "/WaveSimulationData/{SimulationId:guid}"

@using System.Globalization
@using System.Text
@using System.Text.Json
@using System.IO
@using Microsoft.JSInterop
@using CPT.Models.SimulationResults
@using CPT.Models.WaveEquation
@using CPT.Services
@using cpt.Components.Shared
@using cpt.Models.Simulations

@inject UserSettingsApiService UserSettingsApi
@inject IJSRuntime JS
@inject WaveEquationApiService WaveEquationApi
@inject NavigationManager Nav

<ProtectedRouteView AllowAnonymous="@Demo">

    <div class="hx-08 wvl-5"></div>

    <div class="flex flex-end wf wvl-5 mgb-2">

        @if (Demo)
        {
            <div class="mgr-3">

                <button class="bg-card pd fsz-10 corner-2 bd wx-15 flex flex-center shadow-border-2" @onclick="ExitDemo">

                    <i class="mdi mdi-exit-to-app bg-card fsz-10 mgr-5"></i>
                    Exit Demo

                </button>

            </div>
        }

        <div>

            <button class="bg-primary pd fsz-10 corner-2 bd-none wx-15 flex flex-center shadow-border-2"
                    @onclick="ViewResults">

                <i class="mdi mdi-plus fsz-10 mgr-5"></i>
                View Result

            </button>

        </div>

    </div>


    <div class="bg-card">

        <div class="mgb-5 flex flex-center flex-spacebetween flow bg-primary-02 bd pd border-shadow-5">

            <div class="mgb-5">

                <div class="flex flex-center">

                    <button class="bg-transparent bd-none fsz-15 mgr-2" @onclick="GoBack" title="Go back">

                        <i class="mdi mdi-arrow-left round bd cl-primary bg-card pd fw-bold"></i>

                    </button>

                    <div>

                        <h2 class="mg-0 pdb fsz-18 cl-primary">
                            Simulation Data
                        </h2>

                        <p class="mg-0 fsz-10">
                            Wave Equation (1D) results and exports
                        </p>

                    </div>

                </div>

            </div>


            <div>

                <div class="flex wvg-5">

                    @if (Demo)
                    {
                        <div class="mgr-3">

                            <button class="bg-card pd fsz-10 corner-2 bd wx-15 flex flex-center shadow-border-2"
                                    @onclick="ExitDemo">

                                <i class="mdi mdi-exit-to-app bg-card fsz-10 mgr-5"></i>
                                Exit Demo

                            </button>

                        </div>
                    }

                    <div>

                        <button class="bg-primary pd fsz-10 corner-2 bd-none wx-15 flex flex-center shadow-border-2"
                                @onclick="ViewResults">

                            <i class="mdi mdi-plus fsz-10 mgr-5"></i>
                            View Result

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <div class="mgb scroll wf">

        <button class="fsz-10 bd-none bdb pd mgb-1 mgr-1 @(ActiveTab == "Data Table" ? "bg-primary" : "bg-primary-02")"
                @onclick='() => SetActiveTab("Data Table")'>

            Data Table

        </button>


        <button
            class="fsz-10 bd-none bdb pd bg-transparent mgb-1 mgr-1 @(ActiveTab == "Statistics" ? "bg-primary" : "bg-primary-02")"
            @onclick='() => SetActiveTab("Statistics")'>

            Statistics

        </button>


        @if (!Demo)
        {
            <button
                class="fsz-10 bd-none bdb pd bg-transparent mgb-1 mgr-1 @(ActiveTab == "Export" ? "bg-primary" : "bg-primary-02")"
                @onclick='() => SetActiveTab("Export")'>

                Export

            </button>
        }

    </div>


    <div>

        @if (IsLoading)
        {
            <div class="hf bg-card pd bd corner-2 flex flex-center justify-content-between">

                <LoadingIndicator Text="Loading simulation data..." />

            </div>
        }
        else if (HasError)
        {
            <div class="hf bg-card pd bd corner-2 flex flex-center justify-content-between">

                <p class="fsz-15 fw-bold">
                    Unable to load simulation results.
                </p>

            </div>
        }
        else if (Data is null)
        {
            <div class="hf bg-card pd bd corner-2 flex flex-center justify-content-between">

                <p class="fsz-15 fw-bold">
                    No simulation result was found.
                </p>

            </div>
        }
        else
        {
            @if (ActiveTab == "Data Table")
            {
                <div class="row responsive colm-3">

                    <div class="miwx-25">

                        <div class="wf hx-6 scroll-y">

                            <table class="wf scroll bg-card pd bd corner-2">

                                <thead class="bg-primary-02">

                                    <tr class="mg-0">

                                        <th class="pd mg-0 fsz-12">
                                            x
                                        </th>

                                        <th class="pd fsz-12">
                                            Displacement
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var point in PagedPoints)
                                    {
                                        <tr>

                                            <td class="pd fsz-12 text-center bd-none bdb bdb-primary">

                                                @FormatNumber(
                                                    point.X,
                                                    3)

                                            </td>


                                            <td class="pd fsz-12 text-center bd-none bdb bdb-primary">

                                                @FormatNumber(
                                                    point.Displacement,
                                                    6)

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>


                        <div class="flex flex-spacebetween flow bg-card pd bd corner-1 shadow-border-1 mgb mgt-2">

                            <p class="fsz-12 mgb-3">

                                Showing @StartItem–@EndItem of @TotalPoints grid points

                            </p>


                            <div class="flex flex-center">

                                <button class="mdi mdi-arrow-left pd fsz-12 bg-transparent bd-none bd corner-1"
                                        disabled="@(CurrentPage == 1)" @onclick="PreviousPage">
                                </button>


                                @if (TotalPages <= 5)
                                {
                                    @for (int page = 1; page <= TotalPages; page++)
                                    {
                                        var pageNumber = page;

                                        <button
                                            class="mdi pd fsz-12 bg-transparent bd-none bd corner-1 @(CurrentPage == pageNumber ? "bg-primary" : "")"
                                            @onclick="() => GoToPage(pageNumber)">

                                            @pageNumber

                                        </button>
                                    }
                                }
                                else
                                {
                                    <button
                                        class="mdi pd fsz-12 bg-transparent bd-none bd corner-1 @(CurrentPage == 1 ? "bg-primary" : "")"
                                        @onclick="() => GoToPage(1)">

                                        1

                                    </button>


                                    @if (CurrentPage > 3)
                                    {
                                        <span class="pd fsz-12">
                                            ...
                                        </span>
                                    }


                                    @if (CurrentPage > 2 && CurrentPage < TotalPages - 1)
                                    {
                                        <button class="mdi pd fsz-12 bg-transparent bd-none bd corner-1"
                                                @onclick="() => GoToPage(CurrentPage - 1)">

                                            @(CurrentPage - 1)

                                        </button>
                                    }


                                    @if (CurrentPage != 1 && CurrentPage != TotalPages)
                                    {
                                        <button class="mdi pd fsz-12 bg-transparent bd-none bd corner-1 bg-primary"
                                                @onclick="() => GoToPage(CurrentPage)">

                                            @CurrentPage

                                        </button>
                                    }


                                    @if (CurrentPage > 1 && CurrentPage < TotalPages - 1)
                                    {
                                        <button class="mdi pd fsz-12 bg-transparent bd-none bd corner-1"
                                                @onclick="() => GoToPage(CurrentPage + 1)">

                                            @(CurrentPage + 1)

                                        </button>
                                    }


                                    @if (CurrentPage < TotalPages - 2)
                                    {
                                        <span class="pd fsz-12">
                                            ...
                                        </span>
                                    }


                                    <button
                                        class="mdi pd fsz-12 bg-transparent bd-none bd corner-1 @(CurrentPage == TotalPages ? "bg-primary" : "")"
                                        @onclick="() => GoToPage(TotalPages)">

                                        @TotalPages

                                    </button>
                                }


                                <button class="mdi mdi-arrow-right pd fsz-12 bg-transparent bd-none bd corner-1"
                                        disabled="@(CurrentPage == TotalPages)" @onclick="NextPage">
                                </button>

                            </div>

                        </div>

                    </div>

                </div>
            }
            else if (ActiveTab == "Statistics")
            {
                <div class="row responsive colm-3 wvg-5 scroll-y" style="height: 100vh;">
                    <div class="miwx-25 mgr-10">
                        <div class="bg-card bd corner-1 pd">
                            <h5 class="mgt-0 mgl-0 mgr-0 mgb-10 pdb fsz-15 cl-primary bdb bd-primary">Statistics</h5>
                            <div class="grid gap-1 colm-3">
                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">Minimum Displacement</p>
                                    <h4 class="mg-0 fsz-15 cl-secondary">@FormatNumber(Statistics.Minimum, 6) m</h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">Maximum Displacement</p>

                                    <h4 class="mg-0 fsz-15 cl-secondary"> @FormatNumber(Statistics.Maximum, 6) m</h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">Average Displacement</p>

                                    <h4 class="mg-0 fsz-15 cl-secondary"> @FormatNumber(Statistics.Mean, 6) m</h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">Standard Deviation</p>

                                    <h4 class="mg-0 fsz-15 cl-secondary"> @FormatNumber(Statistics.StandardDeviation, 6) m</h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">Final Simulation Time</p>

                                    <h4 class="mg-0 fsz-15 cl-secondary"> @FormatNumber(Data.FinalTime, 4) s</h4>
                                </div>

                                 <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">Grid Points</p>

                                    <h4 class="mg-0 fsz-15 cl-secondary"> @TotalPoints</h4>
                                </div>
                            </div>
                        </div>


                        <div class="mgt-5 corner-2 bd pd bg-card">

                            <h5 class="mg-0 pdb fsz-15 cl-primary">Wave Parameters</h5>
                            <p class="mg-0 fsz-10 bdb bd-primary pdb"> Numerical and physical parameters used in the simulation</p>


                            <div class="grid gap-1 colm-3 mgt-10">
                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Wave Speed</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@FormatNumber(Data.WaveSpeed, 4) m/s</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Special Step</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@FormatNumber(Data.Dx, 6) m</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Time Step</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@FormatNumber(Data.TimeStep, 6) s</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Time Steps</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@Data.TimeSteps</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">CFL Number</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@FormatNumber(Data.CFLNumber, 6)</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Stability</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@Data.StabilityStatus</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Initial Condition</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@Data.InitialConditionType</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Initial Amplitude</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@Data.InitialAmplitude</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Boundary Condition</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@Data.BoundaryConditionType</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="row responsive colm-3 wvl-5 scroll-y" style="height: 100vh">
                    <div class="miwx-25">
                        <div class="bg-card bd corner-1 pd">
                            <h5 class="mgt-0 mgl-0 mgr-0 mgb-10 pdb fsz-15 cl-primary bdb bd-primary">Statistics</h5>
                            <div class="grid gap-1 colm-3">
                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">Minimum Displacement</p>
                                    <h4 class="mg-0 fsz-15 cl-secondary">@FormatNumber(Statistics.Minimum, 6) m</h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">Maximum Displacement</p>

                                    <h4 class="mg-0 fsz-15 cl-secondary"> @FormatNumber(Statistics.Maximum, 6) m</h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">Average Displacement</p>

                                    <h4 class="mg-0 fsz-15 cl-secondary"> @FormatNumber(Statistics.Mean, 6) m</h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">Standard Deviation</p>

                                    <h4 class="mg-0 fsz-15 cl-secondary"> @FormatNumber(Statistics.StandardDeviation, 6) m</h4>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">Final Simulation Time</p>

                                    <h4 class="mg-0 fsz-15 cl-secondary"> @FormatNumber(Data.FinalTime, 4) s</h4>
                                </div>

                                 <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <p class="mg-0 fsz-10 pdb">Grid Points</p>

                                    <h4 class="mg-0 fsz-15 cl-secondary"> @TotalPoints</h4>
                                </div>
                            </div>
                        </div>


                        <div class="mgt-5 corner-2 bd pd bg-card">

                            <h5 class="mg-0 pdb fsz-15 cl-primary">Wave Parameters</h5>
                            <p class="mg-0 fsz-10 bdb bd-primary pdb"> Numerical and physical parameters used in the simulation</p>


                            <div class="grid gap-1 colm-3 mgt-10">
                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Wave Speed</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@FormatNumber(Data.WaveSpeed, 4) m/s</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Special Step</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@FormatNumber(Data.Dx, 6) m</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Time Step</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@FormatNumber(Data.TimeStep, 6) s</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Time Steps</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@Data.TimeSteps</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">CFL Number</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@FormatNumber(Data.CFLNumber, 6)</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Stability</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@Data.StabilityStatus</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Initial Condition</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@Data.InitialConditionType</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Initial Amplitude</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@Data.InitialAmplitude</div>
                                </div>

                                <div class="pd bg-secondary-01 bdl bd-secondary bdw-3 mgb">
                                    <span class="fsz-10">Boundary Condition</span>

                                    <div class="mgt-5 fw-600 cl-secondary">@Data.BoundaryConditionType</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (ActiveTab == "Export" && !Demo)
            {
                <div class="wf miwx-15 mawx-25 bd pd corner-2 bg-card">

                    <h5 class="mg-0 pdb fsz-15 cl-primary bdb bd-primary">

                        Export Options

                    </h5>


                    <div class="mgb-5 mgt-5">

                        <h5 class="mg-0 pdb fsz-12">

                            File Format

                        </h5>


                        <select class="pd bd corner-1 bg-card wf" @bind="ExportFormat">

                            <option value="CSV">
                                CSV
                            </option>

                            <option value="PDF">
                                PDF
                            </option>

                            <option value="PNG">
                                PNG
                            </option>

                        </select>

                    </div>


                    <div>

                        <h5 class="mg-0 pdb fsz-12">

                            Include

                        </h5>


                        <div class="flex flex-start">

                            <div class="flex flex-center">

                                <input type="checkbox" @bind="IncludeParameters">

                                <p class="fsz-12 mgl-3">
                                    Parameters
                                </p>

                            </div>

                        </div>


                        <div class="flex flex-start">

                            <div class="flex flex-center">

                                <input type="checkbox" @bind="IncludeGridData">

                                <p class="fsz-12 mgl-3">
                                    Grid Data
                                </p>

                            </div>

                        </div>


                        <div class="flex flex-start">

                            <div class="flex flex-center">

                                <input type="checkbox" @bind="IncludeStatistics">

                                <p class="fsz-12 mgl-3">
                                    Statistics
                                </p>

                            </div>

                        </div>


                        <div class="flex flex-start">

                            <div class="flex flex-center">

                                <input type="checkbox" @bind="IncludeMetadata">

                                <p class="fsz-12 mgl-3">
                                    Metadata
                                </p>

                            </div>

                        </div>


                        <div class="pd mgt-10">

                            <button class="pd bg-primary bd-none bd-primary wf flex- flex-center" @onclick="DownloadData">

                                <i class="mdi mdi-download fsz-15"></i>

                                Download Data

                            </button>

                        </div>

                    </div>

                </div>
            }
        }


        <div class="hx-06 wvl-5"></div>

    </div>


    @if (ShowDemoComplete)
    {
        <DemoComplete CreateAccount="GoToCreateAccount" CreateLater="HideDemoComplete" />
    }


    @if (ShowExitDemoDialog)
    {
        <ConfirmDialog IsVisible="@ShowExitDemoDialog" Title="Exit Demo" Message="Are you sure you want to exit the demo?"
                       ConfirmText="Exit Demo" CancelText="Cancel" Icon="mdi-exit-to-app" OnConfirm="ConfirmExitDemo"
                       OnCancel="CancelExitDemo" />
    }

</ProtectedRouteView>


@code {

    [Parameter]
    public Guid SimulationId { get; set; }


    private SimulationResultDto? Result;

    private WaveEquationResultData? Data;

    private SimulationDto? Simulation;


    private SimulationStatistics Statistics { get; set; } = new();


    private bool IsLoading = true;

    private bool HasError = false;


    private const int PageSize = 20;

    private int CurrentPage = 1;


    private int TotalPoints =>
        Data?.Displacement?.Length ?? 0;


    private int TotalPages =>
        TotalPoints == 0
            ? 1
            : (int)Math.Ceiling(
                TotalPoints /
                (double)PageSize);


    private int StartItem =>
        TotalPoints == 0
            ? 0
            : ((CurrentPage - 1) * PageSize) + 1;


    private int EndItem =>
        Math.Min(
            CurrentPage * PageSize,
            TotalPoints);


    private string ActiveTab { get; set; } =
        "Data Table";


    private string NumberFormat { get; set; } =
        "decimal";


    private string ExportFormat { get; set; } =
        "CSV";


    private bool IncludeParameters { get; set; } =
        true;


    private bool IncludeGridData { get; set; } =
        true;


    private bool IncludeStatistics { get; set; } =
        true;


    private bool IncludeMetadata { get; set; } =
        true;


    [SupplyParameterFromQuery(Name = "from")]
    public string? From { get; set; }


    [SupplyParameterFromQuery(Name = "tab")]
    public string? Tab { get; set; }


    [SupplyParameterFromQuery(Name = "demo")]
    public bool Demo { get; set; }


    private bool ShowDemoComplete { get; set; }

    private bool ShowExitDemoDialog { get; set; }


    private void GoToCreateAccount()
    {
        Nav.NavigateTo("SignUp");
    }


    private void HideDemoComplete()
    {
        ShowDemoComplete = false;
    }


    private void ExitDemo()
    {
        ShowExitDemoDialog = true;
    }


    private void ConfirmExitDemo()
    {
        ShowExitDemoDialog = false;

        Nav.NavigateTo("");
    }


    private void CancelExitDemo()
    {
        ShowExitDemoDialog = false;
    }


    private void GoBack()
    {
        if (From == "demo-history")
        {
            Nav.NavigateTo(
                "Admin/DemoHistory");

            return;
        }


        if (From == "history")
        {
            Nav.NavigateTo(
                "SimulationHistory");

            return;
        }


        Nav.NavigateTo(
            $"WaveEquation/Simulate/{SimulationId}");
    }


    private void ViewResults()
    {
        if (Demo)
        {
            Nav.NavigateTo(
                $"WaveResult/{SimulationId}?demo=true");
            return;
        }

        if (From == "demo-history")
        {
            Nav.NavigateTo(
                $"WaveResult/{SimulationId}?from=demo-history");
            return;
        }

        if (From == "history")
        {
            Nav.NavigateTo(
                $"WaveResult/{SimulationId}?from=history");
            return;
        }

        Nav.NavigateTo(
            $"WaveResult/{SimulationId}");
    }


    private void SetActiveTab(string tab)
    {
        ActiveTab = tab;
    }


    protected override async Task OnInitializedAsync()
    {
        if (!Demo &&
            Tab?.Equals(
                "export",
                StringComparison.OrdinalIgnoreCase) == true)
        {
            ActiveTab = "Export";
        }


        try
        {
            var settings =
                await UserSettingsApi.GetAsync();


            if (settings is not null)
            {
                NumberFormat =
                    settings.NumberFormat;
            }


            Result =
                await WaveEquationApi
                    .GetLatestResultAsync(
                        SimulationId);


            Simulation =
                await WaveEquationApi
                    .GetSimulationAsync(
                        SimulationId);


            if (Result?.ResultData is not null)
            {
                Data =
                    JsonSerializer.Deserialize<
                        WaveEquationResultData>(
                            Result.ResultData,
                            new JsonSerializerOptions
                            {
                                PropertyNameCaseInsensitive = true
                            });


                if (Data is not null)
                {
                    CalculateStatistics();
                }
            }
        }
        catch
        {
            HasError = true;
        }
        finally
        {
            IsLoading = false;


            if (Demo &&
                Data is not null)
            {
                ShowDemoComplete = true;
            }
        }
    }


    private string FormatNumber(
        double value,
        int decimalPlaces = 6)
    {
        if (NumberFormat.Equals(
            "integer",
            StringComparison.OrdinalIgnoreCase))
        {
            return Math.Round(value)
                .ToString(
                    "0",
                    CultureInfo.InvariantCulture);
        }


        return value.ToString(
            $"F{decimalPlaces}",
            CultureInfo.InvariantCulture);
    }


    private class WavePoint
    {
        public double X { get; set; }

        public double Displacement { get; set; }
    }


    private IEnumerable<WavePoint> AllPoints
    {
        get
        {
            if (Data?.Displacement is null)
                return [];


            var points =
                new List<WavePoint>();


            for (int i = 0;
                 i < Data.Displacement.Length;
                 i++)
            {
                var x =
                    Data.Length *
                    i /
                    Math.Max(
                        1,
                        Data.GridPoints - 1);


                points.Add(
                    new WavePoint
                    {
                        X = x,
                        Displacement =
                            Data.Displacement[i]
                    });
            }


            return points;
        }
    }


    private IEnumerable<WavePoint> PagedPoints =>
        AllPoints
            .Skip(
                (CurrentPage - 1) *
                PageSize)
            .Take(PageSize);


    private void PreviousPage()
    {
        if (CurrentPage > 1)
        {
            CurrentPage--;
        }
    }


    private void NextPage()
    {
        if (CurrentPage < TotalPages)
        {
            CurrentPage++;
        }
    }


    private void GoToPage(int page)
    {
        if (page >= 1 &&
            page <= TotalPages)
        {
            CurrentPage = page;
        }
    }


    private async Task DownloadData()
    {
        if (Demo ||
            Data is null)
            return;


        
        if (ExportFormat == "CSV")
        {
            var metadata = new
            {
                name = Simulation?.Name ?? "Unnamed Simulation",
                id = SimulationId.ToString(),
                exportDate = DateTime.Now.ToString(
                    "yyyy-MM-dd HH:mm:ss",
                    CultureInfo.InvariantCulture)
            };

            var parameters = new
            {
                gridPoints = Data.GridPoints,
                length = Data.Length,
                waveSpeed = Data.WaveSpeed,
                timeStep = Data.TimeStep,
                timeSteps = Data.TimeSteps,
                finalTime = Data.FinalTime,
                dx = Data.Dx,
                cflNumber = Data.CFLNumber,
                stability = Data.StabilityStatus,
                initialCondition = Data.InitialConditionType,
                initialAmplitude = Data.InitialAmplitude,
                boundaryCondition = Data.BoundaryConditionType
            };

            var statistics = new
            {
                minimum = Statistics.Minimum,
                maximum = Statistics.Maximum,
                mean = Statistics.Mean,
                standardDeviation = Statistics.StandardDeviation,
                gridPoints = TotalPoints
            };

            var gridData = IncludeGridData
                ? AllPoints.Select(point => new
                {
                    x = point.X,
                    displacement = point.Displacement
                }).ToArray()
                : Array.Empty<object>();

            await JS.InvokeVoidAsync(
                "cptDownloadWaveCsv",
                GetDownloadFileName("csv"),
                metadata,
                parameters,
                statistics,
                gridData,
                IncludeMetadata,
                IncludeParameters,
                IncludeStatistics,
                IncludeGridData);

            return;
        }



        if (ExportFormat == "PDF")
        {
            var pdfContent = GeneratePdfContent();

            var gridData = IncludeGridData
                ? AllPoints.Select(point => new
                {
                    x = point.X,
                    displacement = point.Displacement
                }).ToArray()
                : Array.Empty<object>();

            await JS.InvokeVoidAsync(
                "cptDownloadWavePdf",
                GetDownloadFileName("pdf"),
                pdfContent,
                Data.Displacement,
                Data.Length,
                Data.GridPoints,
                Statistics.Minimum,
                Statistics.Maximum,
                gridData,
                IncludeGridData);

            return;
        }
        

        if (ExportFormat == "PNG")
        {
            var pngContent = GeneratePdfContent();

            var gridData = IncludeGridData
                ? AllPoints.Select(point => new
                {
                    x = point.X,
                    displacement = point.Displacement
                }).ToArray()
                : Array.Empty<object>();

            await JS.InvokeVoidAsync(
                "cptDownloadWavePng",
                GetDownloadFileName("png"),
                pngContent,
                Data.Displacement,
                Data.Length,
                Data.GridPoints,
                Statistics.Minimum,
                Statistics.Maximum,
                gridData,
                IncludeGridData);

            return;
        }
    }


