@code {

    [SupplyParameterFromQuery(Name = "from")] public string? From { get; set; }

    [Parameter] public Guid SimulationId { get; set; }

    [SupplyParameterFromQuery(Name = "demo")] public bool Demo { get; set; }

    private bool ShowDemoComplete { get; set; }

    private bool ShowExitDemoDialog { get; set; }

    private SimulationResultDto? Result;

    private WaveEquationResultData? Data;

    private int ResultFrame { get; set; }
    private int AnimationFrame { get; set; }
    private System.Threading.Timer? _animationTimer;
    private bool IsAnimationPlaying { get; set; }
    private const int AnimationIntervalMs = 100;

    private int TotalResultFrames =>
        Data?.DisplacementHistory?.Count ?? 0;

    private double[] CurrentDisplacement =>
        Data?.DisplacementHistory is not null &&
        Data.DisplacementHistory.Count > 0
            ? Data.DisplacementHistory[
                Math.Clamp(
                    ResultFrame,
                    0,
                    Data.DisplacementHistory.Count - 1)]
            : Data?.Displacement ?? [];

    private double[] CurrentAnimationDisplacement =>
    Data?.DisplacementHistory is not null &&
    Data.DisplacementHistory.Count > 0
        ? Data.DisplacementHistory[
            Math.Clamp(
                AnimationFrame,
                0,
                Data.DisplacementHistory.Count - 1)]
        : Data?.Displacement ?? [];

    private double CurrentResultTime =>
        TotalResultFrames <= 1 || Data is null
            ? Data?.FinalTime ?? 0
            : Data.FinalTime *
              ResultFrame /
              (TotalResultFrames - 1);

    private double CurrentAnimationTime =>
    TotalResultFrames <= 1 || Data is null
        ? Data?.FinalTime ?? 0
        : Data.FinalTime *
          AnimationFrame /
          (TotalResultFrames - 1);

    private double AnimationProgress =>
    TotalResultFrames <= 1
        ? 0
        : (double)AnimationFrame /
          (TotalResultFrames - 1) *
          100;

    private string ActiveVisualization { get; set; } = "Wave Profile";

    private bool ShowGrid { get; set; } = false;

    private bool IsLoading = true;

    private bool HasError = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            Result =
                await WaveEquationApiService
                    .GetLatestResultAsync(SimulationId);

            if (Result?.ResultData is not null)
            {
                Data =
                    JsonSerializer.Deserialize<WaveEquationResultData>(
                        Result.ResultData,
                        new JsonSerializerOptions
                        {
                            PropertyNameCaseInsensitive = true
                        });
            }
        }
        catch
        {
            HasError = true;
        }
        finally
        {
            IsLoading = false;

            if (Demo && Data is not null)
            {
                ShowDemoComplete = true;
            }
        }
    }

    private async Task HandleResultFrameChanged(
        ChangeEventArgs e)
    {
        if (int.TryParse(
                e.Value?.ToString(),
                out var frame))
        {
            ResultFrame = Math.Clamp(
                frame,
                0,
                Math.Max(
                    0,
                    TotalResultFrames - 1));

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task PlayAnimation()
    {
        if (TotalResultFrames <= 1)
            return;

        if (AnimationFrame >= TotalResultFrames - 1)
            AnimationFrame = 0;

        StartAnimationTimer();

        await InvokeAsync(StateHasChanged);
    }

    private async Task PauseAnimation()
    {
        StopAnimationTimer();

        await InvokeAsync(StateHasChanged);
    }

    private async Task ToggleAnimation()
    {
        if (IsAnimationPlaying)
            await PauseAnimation();
        else
            await PlayAnimation();
    }

    private async Task PreviousAnimationFrame()
    {
        StopAnimationTimer();

        AnimationFrame = Math.Max(0, AnimationFrame - 1);

        await InvokeAsync(StateHasChanged);
    }

    private async Task NextAnimationFrame()
    {
        StopAnimationTimer();

        AnimationFrame = Math.Min(
            Math.Max(0, TotalResultFrames - 1),
            AnimationFrame + 1);

        await InvokeAsync(StateHasChanged);
    }

    private void StartAnimationTimer()
    {
        StopAnimationTimer();

        IsAnimationPlaying = true;

        _animationTimer = new System.Threading.Timer(
            _ =>
            {
                _ = InvokeAsync(() =>
                {
                    if (_isDisposed ||
                        !IsAnimationPlaying ||
                        ActiveVisualization != "Animation" ||
                        TotalResultFrames <= 1)
                    {
                        StopAnimationTimer();
                        StateHasChanged();
                        return;
                    }

                    if (AnimationFrame >= TotalResultFrames - 1)
                    {
                        StopAnimationTimer();
                        StateHasChanged();
                        return;
                    }

                    AnimationFrame++;

                    if (AnimationFrame >= TotalResultFrames - 1)
                        StopAnimationTimer();

                    StateHasChanged();
                });
            },
            null,
            AnimationIntervalMs,
            AnimationIntervalMs);
    }

    private void StopAnimationTimer()
    {
        IsAnimationPlaying = false;

        _animationTimer?.Dispose();
        _animationTimer = null;
    }

    private bool _isDisposed;

    public void Dispose()
    {
        _isDisposed = true;
        StopAnimationTimer();
    }

    private void BackToSimulationData()
    {
        if (Demo)
        {
            Nav.NavigateTo(
                $"WaveSimulationData/{SimulationId}?demo=true");

            return;
        }

        if (From == "demo-history")
        {
            Nav.NavigateTo(
                $"WaveSimulationData/{SimulationId}?from=demo-history");

            return;
        }

        if (From == "history")
        {
            Nav.NavigateTo(
                $"WaveSimulationData/{SimulationId}?from=history");

            return;
        }

        Nav.NavigateTo(
            $"WaveSimulationData/{SimulationId}");
    }

    private async Task BackToDashboard()
    {
        var currentUser =
            await AuthService.GetCurrentUserAsync();

        if (currentUser?.Roles?.Contains(
                "SuperAdmin",
                StringComparer.OrdinalIgnoreCase) == true ||
            currentUser?.Roles?.Contains(
                "Admin",
                StringComparer.OrdinalIgnoreCase) == true)
        {
            Nav.NavigateTo("Admin/Dashboard");
            return;
        }

        Nav.NavigateTo("Dashboard");
    }

    private void ExitDemo()
    {
        ShowExitDemoDialog = true;
    }

    private void ConfirmExitDemo()
    {
        ShowExitDemoDialog = false;
        Nav.NavigateTo("");
    }

    private void CancelExitDemo()
    {
        ShowExitDemoDialog = false;
    }

    private void GoToCreateAccount()
    {
        Nav.NavigateTo("SignUp");
    }

    private void HideDemoComplete()
    {
        ShowDemoComplete = false;
    }
}