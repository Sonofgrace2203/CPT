@page "/WaveEquation/Simulate/{SimulationId:guid}"

@using CPT.Services
@using CPT.Models.WaveEquation
@using cpt.Components.Shared
@using cpt.Components.Setups.WaveEquation
@using cpt.Components.Visualization.WaveEquation
@using CPT.Services.Physics.WaveEquation

@inject WaveEquationApiService WaveEquationApi
@inject WaveEquationState WaveEquationState
@inject NavigationManager Nav

<ProtectedRouteView AllowAnonymous="@Demo">

    <div class="hx-08 wvl-5"></div>

    <div class="bg-card">
        <div class="mgb-5 flex flex-center flex-spacebetween bg-primary-02 bd pd border-shadow-5">

            <div>

                <h2 class="mg-0 pdb fsz-18 cl-primary">
                    Wave Equation (1D)
                </h2>

                <p class="mg-0 fsz-10">

                    @switch (Progress?.Status)
                    {
                        case "Queued":
                            <span>Queued</span>
                            break;

                        case "Running":
                            <span>Running...</span>
                            break;

                        case "Completed":
                            <span>Completed</span>
                            break;

                        case "Failed":
                            <span>Failed</span>
                            break;

                        case "Canceled":
                            <span>Canceled</span>
                            break;

                        default:
                            <span>Preparing...</span>
                            break;
                    }

                </p>

            </div>

        </div>
    </div>


    <div class="scroll-y" style="height: 100vh;">

        <div class="row responsive colm-3">

            <div class="corner-2 bd pd bg-card miwx-25 mgb-3">

                <h3 class="fsz-15 cl-primary bdb bd-primary mgb-10 pdb">
                    Progress
                </h3>


                <!-- Progress -->

                <div class="mgb-5 wf">

                    <h5 class="mg-0 pdb fsz-13">
                        Time Progress
                    </h5>

                    <div class="flex flex-center">

                        <div class="hx-01 wf corner-5 bg-gray mgr-3">

                            <div class="bg-secondary hx-01 corner-3" style="@($"width: {DisplayedPercent}%")">
                            </div>

                        </div>

                        <h3 class="mg-0 fsz-15">
                            @($"{DisplayedPercent:F0}%")
                        </h3>

                    </div>


                    <div class="mgt-5">

                        <div class="flex flex-spacebetween mgb-1">

                            <h3 class="mg-0 fsz-15">
                                Current Time
                            </h3>

                            <h3 class="mg-0 fsz-15">

                                @(Progress is null
                                    ? "0.000 / 0.000"
                                    : $"{Progress.CurrentTime:F3} / {Progress.TotalTime:F3}")

                            </h3>

                        </div>


                        <div class="flex flex-spacebetween mgb-1">

                            <h3 class="mg-0 fsz-15">
                                Time Steps
                            </h3>

                            <h3 class="mg-0 fsz-15">

                                @(Progress is null
                                    ? "0 / 0"
                                    : $"{Progress.CurrentStep} / {Progress.TotalSteps}")

                            </h3>

                        </div>


                        <div class="flex flex-spacebetween mgb-1">

                            <h3 class="mg-0 fsz-15">
                                Elapsed Time
                            </h3>

                            <h3 class="mg-0 fsz-15 op-5">
                                @FormatTime(
                                    Progress?.ElapsedTimeMs ?? 0)
                            </h3>

                        </div>

                    </div>


                    <div class="flex flex-spacebetween mgb-1">

                        <h3 class="mg-0 fsz-15">
                            Estimated Time Left
                        </h3>

                        <h3 class="mg-0 fsz-15 op-5">
                            @FormatTime(
                                Progress?.EstimatedTimeRemainingMs ?? 0)
                        </h3>

                    </div>

                </div>


                <!-- Live Preview -->

                <div class="row responsive colm-3 bd pd corner-2">

                    <div class="mgt-10 miwx-25 mgr-2">

                        <h5 class="mg-0 pdb fsz-13 fw-bold cl-primary">
                            Live Preview (Displacement)
                        </h5>

                        @if (Progress?.Displacement is not null)
                        {
                            <div class="pd bg-card bd corner-2">
                                @* <WaveProfile Displacement="Progress.Displacement"
                                             Length="WaveEquationState.Configuration?.Length ?? 10.0"
                                             CurrentTime="Progress.CurrentTime" /> *@

                                <WaveProfile Displacement="Progress.Displacement" DisplacementHistory="DisplacementHistory"
                                             Length="WaveEquationState.Configuration?.Length ?? 10.0"
                                             CurrentTime="Progress.CurrentTime"
                                             TimeStep="WaveEquationState.Configuration?.TimeStep ?? 0.01" />
                            </div>
                        }
                        else if (IsRunning)
                        {
                            <p class="fsz-12">Waiting for simulation data...</p>
                        }

                    </div>


                    <!-- Live information -->

                    <div class="corner-2 bd pd bg-card miwx-25 mgb-1 wvg-5">

                        <div class="flex flex-start wf">

                            <div class="corner-1 mgr-3 mgb-3 wf">

                                <h3 class="fsz-15 cl-primary bdb bd-primary mgb-10 pdb">
                                    Wave Information
                                </h3>


                                @if (Progress?.Displacement is not null)
                                {
                                    <p class="fsz-12">
                                        [CPT] Grid points:
                                        @Progress.Displacement.Length
                                    </p>

                                    <p class="fsz-12">
                                        [CPT] Maximum displacement:
                                        @Progress.Displacement.Max().ToString(
                                            "F6",
                                            System.Globalization.CultureInfo.InvariantCulture)
                                    </p>

                                    <p class="fsz-12">
                                        [CPT] Minimum displacement:
                                        @Progress.Displacement.Min().ToString(
                                            "F6",
                                            System.Globalization.CultureInfo.InvariantCulture)
                                    </p>
                                }
                                else
                                {
                                    <p class="fsz-12">
                                        [CPT] Waiting for displacement data...
                                    </p>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Console Output -->

        <div class="corner-2 bd pd bg-card miwx-25 mgb-1 wvl-5">

            <div class="flex flex-start wf">

                <div class="corner-1 mgr-3 mgb-3 wf">

                    <h3 class="fsz-15 cl-primary bdb bd-primary mgb-10 pdb">
                        Console Output
                    </h3>


                    <div class="flow">

                        @if (Progress is null)
                        {
                            <p class="fsz-12">
                                Initializing simulation...
                            </p>
                        }
                        else
                        {
                            <p class="fsz-12">
                                [CPT] Simulation @Progress.SimulationId
                            </p>


                            @if (Progress.Status == "Queued")
                            {
                                <p class="fsz-12">
                                    [CPT] Simulation queued for execution...
                                </p>
                            }


                            @if (Progress.Status == "Running")
                            {
                                <p class="fsz-12">
                                    [CPT] Wave equation solver running...
                                </p>

                                <p class="fsz-12">
                                    [CPT] Time step:
                                    @Progress.CurrentStep /
                                    @Progress.TotalSteps
                                </p>

                                <p class="fsz-12">
                                    [CPT] Simulation time:
                                    @Progress.CurrentTime:F3 /
                                    @Progress.TotalTime:F3
                                </p>

                                <p class="fsz-12">
                                    [CPT] Progress:
                                    @Progress.Percent:F0%
                                </p>
                            }


                            @if (Progress.Status == "Completed")
                            {
                                <p class="fsz-12">
                                    [CPT] Simulation completed successfully.
                                </p>

                                <p class="fsz-12">
                                    [CPT] Final time:
                                    @Progress.CurrentTime:F3
                                </p>

                                <p class="fsz-12">
                                    [CPT] Total execution time:
                                    @FormatTime(
                                        Progress.ElapsedTimeMs)
                                </p>
                            }


                            @if (Progress.Status == "Failed")
                            {
                                <p class="fsz-12">
                                    [CPT] Simulation failed.
                                </p>

                                @if (!string.IsNullOrWhiteSpace(
                                    Progress.ErrorMessage))
                                {
                                    <p class="fsz-12">
                                        [CPT] Error:
                                        @Progress.ErrorMessage
                                    </p>
                                }
                            }


                            @if (Progress.Status == "Canceled")
                            {
                                <p class="fsz-12">
                                    [CPT] Simulation canceled.
                                </p>
                            }

                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- Actions -->

        <div class="flex flex-end pd">

            @if (IsCompleted)
            {
                <button class="pd corner-1 bg-secondary bd-none fsz-12 mgr-5" @onclick="ViewResults">

                    View Results

                    <i class="mdi mdi-arrow-rigt fsz-15"></i>

                </button>
            }


            @if (IsRunning)
            {
                <button class="pd corner-1 bg-card cl-error bd-none bd bd-error fsz-12" @onclick="StopSimulation">

                    Stop

                    <i class="mdi mdi-arrow-rigt fsz-15"></i>

                </button>
            }

        </div>

    </div>


    <div class="hx-06 wvl-5"></div>


    <ConfirmDialog IsVisible="@ShowStopDialog" Title="Stop Simulation"
                   Message="Are you sure you want to stop this simulation?" ConfirmText="Stop" CancelText="Cancel"
                   Icon="mdi-stop-circle-outline" OnConfirm="ConfirmStopSimulation" OnCancel="CancelStopSimulation" />

</ProtectedRouteView>


@code {

    [Parameter] public Guid SimulationId { get; set; }
    [SupplyParameterFromQuery(Name = "demo")] public bool Demo { get; set; }


    private bool IsRunning;
    private bool IsCompleted;
    private bool HasError;
    private bool ShowStopDialog;

    private WaveEquationProgress? Progress;
    private double DisplayedPercent;
    private List<double[]> DisplacementHistory = new();

    private System.Threading.Timer? _progressAnimationTimer;
    private CancellationTokenSource? _progressCancellation;


    protected override async Task OnInitializedAsync()
    {
        await RunSimulation();
    }


    private async Task RunSimulation()
    {
        IsRunning = true;

        IsCompleted = false;

        HasError = false;

        DisplayedPercent = 0;


        Progress = new WaveEquationProgress
        {
            SimulationId = SimulationId,
            Status = "Queued",
            CurrentStep = 0,
            TotalSteps = 0,
            CurrentTime = 0,
            TotalTime = 0,
            Percent = 0
        };


        StartProgressAnimation();


        _progressCancellation =
            new CancellationTokenSource();


        try
        {
            var runSucceeded =
                await WaveEquationApi.RunSimulationAsync(
                    SimulationId);


            if (!runSucceeded)
            {
                HasError = true;
                return;
            }


            await PollProgressAsync();
        }
        catch (OperationCanceledException)
        {
            // Expected when the user stops the simulation.
        }
        catch
        {
            HasError = true;
        }
        finally
        {
            IsRunning = false;


            if (Progress?.Status == "Completed")
            {
                DisplayedPercent = 100;
                IsCompleted = true;
            }


            StopProgressAnimation();


            _progressCancellation?.Cancel();

            _progressCancellation?.Dispose();

            _progressCancellation = null;


            await InvokeAsync(
                StateHasChanged);
        }
    }


    private async Task PollProgressAsync()
    {
        while (!_progressCancellation!.Token.IsCancellationRequested)
        {
            var progress =
                await WaveEquationApi.GetProgressAsync(
                    SimulationId);


            if (progress is not null)
            {
                Progress = progress;

                if (progress.Displacement is not null &&
                    progress.Displacement.Length > 1)
                {
                    bool isNewSnapshot =
                        DisplacementHistory.Count == 0 ||
                        !DisplacementHistory[^1].SequenceEqual(
                            progress.Displacement);

                    if (isNewSnapshot)
                    {
                        DisplacementHistory.Add(
                            (double[])progress.Displacement.Clone());
                    }
                }

                await InvokeAsync(
                    StateHasChanged);


                if (progress.Status == "Completed")
                {
                    IsCompleted = true;

                    DisplayedPercent = 100;


                    await InvokeAsync(
                        StateHasChanged);

                    return;
                }


                if (progress.Status == "Failed")
                {
                    HasError = true;


                    await InvokeAsync(
                        StateHasChanged);

                    return;
                }


                if (progress.Status == "Canceled")
                {
                    return;
                }
            }
            else
            {
                var result =
                    await WaveEquationApi.GetLatestResultAsync(
                        SimulationId);


                if (result?.Status == "Completed")
                {
                    IsCompleted = true;

                    DisplayedPercent = 100;


                    Progress ??=
                        new WaveEquationProgress();


                    Progress.SimulationId =
                        SimulationId;

                    Progress.Status =
                        "Completed";

                    Progress.Percent =
                        100;


                    await InvokeAsync(
                        StateHasChanged);

                    return;
                }
            }


            await Task.Delay(
                250,
                _progressCancellation.Token);
        }
    }


    private string FormatTime(
        double milliseconds)
    {
        if (milliseconds <= 0)
            return "00:00:00.000";


        var time =
            TimeSpan.FromMilliseconds(
                milliseconds);


        if (time.TotalSeconds < 1)
        {
            return $"{milliseconds:F0} ms";
        }


        return time.ToString(
            @"hh\:mm\:ss\.fff");
    }


    private string BuildWavePoints()
    {
        if (Progress?.Displacement is null ||
            Progress.Displacement.Length < 2)
        {
            return string.Empty;
        }


        var displacement =
            Progress.Displacement;


        var width = 700.0;

        var height = 240.0;

        var left = 50.0;

        var top = 30.0;


        var maxAbs =
            displacement
                .Select(Math.Abs)
                .DefaultIfEmpty(1.0)
                .Max();


        if (maxAbs <= 0)
            maxAbs = 1.0;


        var points = new System.Text.StringBuilder();


        for (int i = 0;
             i < displacement.Length;
             i++)
        {
            var x =
                left +
                width *
                i /
                (displacement.Length - 1);


            var normalized =
                displacement[i] /
                maxAbs;


            var y =
                top +
                height / 2.0 -
                normalized *
                (height / 2.0);


            points.Append(
                $"{x.ToString(
                    "F2",
                    System.Globalization.CultureInfo.InvariantCulture)},");
            
            points.Append(
                $"{y.ToString(
                    "F2",
                    System.Globalization.CultureInfo.InvariantCulture)} ");

        }


        return points.ToString();
    }


    private void ViewResults()
    {
        if (Demo)
        {
            Nav.NavigateTo(
                $"WaveSimulationData/{SimulationId}?demo=true");

            return;
        }

        Nav.NavigateTo(
            $"WaveSimulationData/{SimulationId}");
    }


    private Task StopSimulation()
    {
        ShowStopDialog = true;

        return Task.CompletedTask;
    }


    private async Task ConfirmStopSimulation()
    {
        ShowStopDialog = false;


        _progressCancellation?.Cancel();


        await WaveEquationApi.CancelSimulationAsync(
            SimulationId);


        if (Demo)
        {
            Nav.NavigateTo(
                Nav.BaseUri);
        }
        else
        {
            Nav.NavigateTo(
                "Modules");
        }
    }


    private void CancelStopSimulation()
    {
        ShowStopDialog = false;
    }


    private void StartProgressAnimation()
    {
        _progressAnimationTimer?.Dispose();


        _progressAnimationTimer =
            new System.Threading.Timer(
                _ =>
                {
                    if (Progress is null)
                        return;


                    var target =
                        Progress.Percent;


                    if (DisplayedPercent < target)
                    {
                        var difference =
                            target -
                            DisplayedPercent;


                        DisplayedPercent +=
                            Math.Max(
                                0.1,
                                difference * 0.15);


                        if (DisplayedPercent > target)
                        {
                            DisplayedPercent =
                                target;
                        }


                        InvokeAsync(
                            StateHasChanged);
                    }

                },
                null,
                TimeSpan.Zero,
                TimeSpan.FromMilliseconds(50));
    }


    private void StopProgressAnimation()
    {
        _progressAnimationTimer?.Dispose();

        _progressAnimationTimer = null;
    }

}