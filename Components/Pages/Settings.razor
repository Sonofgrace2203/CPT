@code {
    private bool general = true;
    private bool simulation = false;
    @* private bool storage = false;
    private bool shortcuts = false; *@

    private string NumberFormat = "decimal";
    private bool AutoSaveSimulation = true;
    private bool ConfirmBeforeDelete = true;

    private string SolverType = "Finite Difference";
    private int GridWidth = 100;
    private int GridHeight = 100;
    private double TimeStep = 0.001;
    private double TotalTime = 10.0;
    private string BoundaryCondition = "Fixed Temperature";

    protected override async Task OnInitializedAsync()
    {
        var settings = await UserSettingsApi.GetAsync();

        if (settings is not null)
        {
            NumberFormat = settings.NumberFormat;
            AutoSaveSimulation = settings.AutoSaveSimulation;
            ConfirmBeforeDelete = settings.ConfirmBeforeDelete;

            SolverType = settings.SolverType;
            GridWidth = settings.GridWidth;
            GridHeight = settings.GridHeight;
            TimeStep = settings.TimeStep;
            TotalTime = settings.TotalTime;
            BoundaryCondition = settings.BoundaryCondition;
        }
    }

    private void OnTimeStepInput(ChangeEventArgs e)
    {
        if (double.TryParse(
            e.Value?.ToString(),
            NumberStyles.Float,
            CultureInfo.InvariantCulture,
            out var value))
        {
            TimeStep = value;
        }
    }

    private void General()
    {
        general = true;
        simulation = false;
    }

