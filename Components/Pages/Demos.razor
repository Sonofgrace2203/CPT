@page "/Demos"
@inject NavigationManager Nav
@layout MobileMainLayout

<div class="pd flex flex-spacebetween flex-center homebg1 shadow-border-1">
    <div class="cl-white"
         @onclick='() => Nav.NavigateTo("")'
         style="cursor: pointer;">
        <div class="flex flex-center">
            <img src="icons/cpt/cptLogo.png"
                 alt="CPT Logo"
                 class="wx-04 hx-04 mgr-3" />

            <div class="mgt--2">
                <h3 class="mg-0 pdb-1">CPT</h3>
                <p class="mg-0 fsz-8">Computational Physics Toolkit</p>
            </div>
        </div>
    </div>

    <button type="button" style="cursor: pointer;"
            class="pdt-1 pdb-1 pdl-10 pdr-10 bd bd-primary corner-5 bg-primary fsz-10"
            @onclick='() => Nav.NavigateTo("Login")'>
        Log In
    </button>
</div>

<div class="homebg pd">
    <div class="pd">
        <div class="text-center mgb-10">
            <h1 class="mg-0 pdb-2 fsz-20 cl-white">
                Explore CPT Demos
            </h1>

            <p class="mg-0 fsz-11 cl-white">
                Explore computational physics simulations before creating an account.
                Choose a module below to get started.
            </p>
        </div>

        <div class="grid colm-25 gap-1">

            <!-- Heat Transfer -->
            <div class="pd corner-2 bg-card-07 shadow-border-2" style="cursor: pointer;"
                @onclick='() => Nav.NavigateTo("HeatEquation?demo=true&from=demos")'>
                <div class="flex">
                    <i class="mdi mdi-thermometer fsz-25 mgr-3 cl-primary"></i>

                    <div>
                        <h4 class="mg-0 pdb fsz-15 cl-primary">
                            Heat Transfer
                        </h4>

                        <p class="mg-0 fsz-12">
                            Heat Equation Simulation
                        </p>
                    </div>
                </div>

                <div class="text-right mgt-3">
                    <button type="button" style="cursor: pointer;"
                            class="cl-primary fsz-10 bg-transparent bd-none"
                            @onclick='() => Nav.NavigateTo("HeatEquation?demo=true&from=demos")'>
                        Run Demo
                        <i class="mdi mdi-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- Wave Equation -->
            <div class="pd corner-2 bg-card-07 shadow-border-2" style="cursor: pointer;"
                @onclick='() => Nav.NavigateTo("WaveEquation?demo=true&from=demos")'>
                <div class="flex">
                    <i class="mdi mdi-waveform fsz-25 mgr-3 cl-primary"></i>

                    <div>
                        <h4 class="mg-0 pdb fsz-15 cl-primary">
                            Wave Equation
                        </h4>

                        <p class="mg-0 fsz-12">
                            1D Wave Propagation
                        </p>
                    </div>
                </div>

                <div class="text-right mgt-3">
                    <button type="button" style="cursor: pointer;"
                            class="cl-primary fsz-10 bg-transparent bd-none"
                            @onclick='() => Nav.NavigateTo("WaveEquation?demo=true&from=demos")'>
                        Run Demo
                        <i class="mdi mdi-arrow-right"></i>
                    </button>
                </div>
            </div>

        </div>

        <div class="text-center mgt-20">
            <p class="fsz-10 cl-white">
                Want to save your simulations and access your personal dashboard?
            </p>

            <button type="button"
                    class="pd-2 bg-primary corner-2 bd-none fsz-10" style="cursor: pointer;"
                    @onclick='() => Nav.NavigateTo("SignUp")'>
                Create Free Account
            </button>
        </div>
    </div>
</div>