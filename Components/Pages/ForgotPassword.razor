@page "/ForgotPassword"

@using CPT.Models.Auth
@using CPT.Services.Auth

@inject AuthService AuthService
@inject NavigationManager Nav

@layout MobileMainLayout

<div class="homebg flex flex-center">
    <div class="bg-card shadow-border-5 pd">
        <div class="pd">

            @if (isSubmitted)
            {
                <div class="text-center">

                    <i class="mdi mdi-email-check-outline cl-primary fsz-30"></i>

                    <h3 class="mg-0 pdt-3 pdb-2">
                        Check Your Email
                    </h3>

                    <p class="fsz-10 pdb-3">
                        If an account exists with this email,
                        we've sent you a password reset link.
                    </p>

                    <button type="button" class="wf pd-2 bg-primary corner-2 bd-none fsz-10"
                            @onclick='() => Nav.NavigateTo("Login")'>
                        Back to Login
                    </button>

                </div>
            }
            else
            {
                <div class="text-center mgb-5">

                    <i class="mdi mdi-lock-reset cl-primary fsz-30"></i>

                    <h3 class="mg-0 pdt-3 pdb-2">
                        Forgot Your Password?
                    </h3>

                    <p class="mg-0 fsz-10 wx-3">
                        Enter the email address associated with
                        your CPT account and we'll send you a
                        password reset link.
                    </p>

                </div>

                <EditForm Model="@forgotPasswordRequest" OnValidSubmit="@SendResetLink">

                    <DataAnnotationsValidator />

                    <div class="mgb-3">
                        <div class="stack">

                            <label for="email" class="fsz-10 mgb-1">
                                <i class="mdi mdi-email-outline"></i>
                                Email Address
                            </label>

                            <InputText id="email" type="email" placeholder="Enter email"
                                       class="pd-2 corner-2 bd bd-dark-02 fsz-10" @bind-Value="forgotPasswordRequest.Email" />

                            <ValidationMessage For="@(() => forgotPasswordRequest.Email)" class="auth-validation" />

                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="auth-error mgb-3">
                            @errorMessage
                        </div>
                    }

                    <div class="mgb-3">

                        <button type="submit" class="wf pd-2 bg-primary corner-2 bd-none fsz-10" disabled="@isLoading">

                            @if (isLoading)
                            {
                                <span>Sending Reset Link...</span>
                            }
                            else
                            {
                                <span>Send Reset Link</span>
                            }

                        </button>

                    </div>

                    <div class="text-center">

                        <button type="button" class="bd-none bg-transparent cl-primary fsz-10 op-10"
                                @onclick='() => Nav.NavigateTo("Login")'>
                            Back to Login
                        </button>

                    </div>

                </EditForm>
            }

        </div>
    </div>
</div>

@code {
    private ForgotPasswordRequest forgotPasswordRequest = new();

    private bool isLoading = false;
    private bool isSubmitted = false;

    private string? errorMessage;

    private async Task SendResetLink()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            var success =
                await AuthService.ForgotPasswordAsync(
                    forgotPasswordRequest.Email);

            if (success)
            {
                isSubmitted = true;
                return;
            }

            errorMessage =
                "Unable to process your request. Please try again.";
        }
        catch
        {
            errorMessage =
                "Unable to connect to CPT. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}