@page "/ResetPassword"

@using CPT.Models.Auth
@using CPT.Services.Auth

@inject AuthService AuthService
@inject NavigationManager Nav

@layout MobileMainLayout

<div class="homebg flex flex-center">
    <div class="bg-card shadow-border-5 pd">
        <div class="pd">

            @if (isResetting)
            {
                <div class="text-center">

                    <i class="mdi mdi-lock-reset cl-primary fsz-30"></i>

                    <h3 class="mg-0 pdt-3 pdb-2">
                        Reset Your Password
                    </h3>

                    <p class="fsz-10">
                        Enter a new password for your CPT account.
                    </p>

                    <EditForm Model="@resetPasswordRequest" OnValidSubmit="@ResetOldPassword">

                        <DataAnnotationsValidator />

                        <!-- New Password -->
                        <div class="mgb-3">
                            <div class="stack">

                                <label for="newPassword" class="fsz-10 mgb-1">
                                    <i class="mdi mdi-lock-outline"></i>
                                    New Password
                                </label>

                                <div class="flex flex-center pos-rel">
                                    <InputText id="newPassword" type="@(showPassword ? "text" : "password")"
                                               placeholder="Enter password" class="corner-2 pd-2 bd wf fsz-10"
                                               @bind-Value="resetPasswordRequest.NewPassword" />

                                    <button type="button" class="bd-none bg-transparent pos-abs r-0 mgr-2"
                                            @onclick="TogglePassword">
                                        <i class="mdi @(showPassword ? "mdi-eye-off" : "mdi-eye") fsz-12"></i>
                                    </button>
                                </div>

                                <ValidationMessage For="@(() => resetPasswordRequest.NewPassword)"
                                                   class="auth-validation" />

                            </div>
                        </div>

                        <!-- Confirm Password -->
                        <div class="mgb-3">
                            <div class="stack">

                                <label for="confirmPassword" class="fsz-10 mgb-1">
                                    <i class="mdi mdi-lock-outline"></i>
                                    Confirm Password
                                </label>

                                <div class="flex flex-center pos-rel">
                                    <InputText id="confirmPassword" type="@(showConfirmPassword ? "text" : "password")"
                                               placeholder="Confirm new password" class="corner-2 pd-2 bd wf fsz-10"
                                               @bind-Value="resetPasswordRequest.ConfirmPassword" />

                                    <button type="button" class="bd-none bg-transparent pos-abs r-0 mgr-2"
                                            @onclick="ToggleConfirmPassword">
                                        <i class="mdi @(showConfirmPassword ? "mdi-eye-off" : "mdi-eye") fsz-12"></i>
                                    </button>
                                </div>

                                <ValidationMessage For="@(() => resetPasswordRequest.ConfirmPassword)"
                                                   class="auth-validation" />

                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="auth-error mgb-3">
                                @errorMessage
                            </div>
                        }

                        <div class="mgb-3">

                            <button type="submit" class="wf pd-2 bg-primary corner-2 bd-none fsz-10" disabled="@isLoading">

                                @if (isLoading)
                                {
                                    <span>Resetting Password...</span>
                                }
                                else
                                {
                                    <span>Reset Password</span>
                                }

                            </button>

                        </div>

                    </EditForm>

                </div>
            }
            else if (isSuccessful)
            {
                <div class="text-center">

                    <i class="mdi mdi-check-circle-outline cl-primary fsz-30"></i>

                    <h3 class="mg-0 pdt-3 pdb-2">
                        Password Reset Successfully
                    </h3>

                    <p class="fsz-10 pdb-3">
                        Your CPT password has been changed successfully.
                        You can now log in using your new password.
                    </p>

                    <button type="button" class="wf pd-2 bg-primary corner-2 bd-none fsz-10"
                            @onclick='() => Nav.NavigateTo("/Login")'>
                        Go to Login
                    </button>

                </div>
            }
            else
            {
                <div class="text-center">

                    <i class="mdi mdi-alert-circle-outline cl-primary fsz-30"></i>

                    <h3 class="mg-0 pdt-3 pdb-2">
                        Reset Link Invalid
                    </h3>

                    <p class="fsz-10 pdb-3">
                        @errorMessage
                    </p>

                    <button type="button" class="wf pd-2 bg-primary corner-2 bd-none fsz-10"
                            @onclick='() => Nav.NavigateTo("/ForgotPassword")'>
                        Request New Link
                    </button>

                    <div class="pdt-3">

                        <button type="button" class="bd-none bg-transparent cl-primary fsz-10 op-10"
                                @onclick='() => Nav.NavigateTo("/Login")'>
                            Back to Login
                        </button>

                    </div>

                </div>
            }

        </div>
    </div>
</div>

@code {
    private ResetPasswordRequest resetPasswordRequest = new();

    private bool isResetting = true;
    private bool isSuccessful = false;

    private bool showPassword = false;
    private bool showConfirmPassword = false;

    private bool isLoading = false;

    private string errorMessage = string.Empty;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);

        var query =
            System.Web.HttpUtility.ParseQueryString(uri.Query);

        var userId =
            query["userId"];

        var token =
            query["token"];

        if (string.IsNullOrWhiteSpace(userId) ||
            string.IsNullOrWhiteSpace(token))
        {
            isResetting = false;

            errorMessage =
                "This password reset link is incomplete or invalid.";

            return;
        }

        resetPasswordRequest.UserId = userId;
        resetPasswordRequest.Token = token;
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private void ToggleConfirmPassword()
    {
        showConfirmPassword = !showConfirmPassword;
    }

    private async Task ResetOldPassword()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            var success =
                await AuthService.ResetPasswordAsync(
                    resetPasswordRequest);

            if (success)
            {
                isResetting = false;
                isSuccessful = true;
                return;
            }

            isResetting = false;
            errorMessage =
                "This password reset link is invalid or has expired.";
        }
        catch
        {
            errorMessage =
                "Unable to reset your password. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}