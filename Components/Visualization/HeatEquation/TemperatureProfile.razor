@using Plotly.Blazor
@using Plotly.Blazor.Traces
@using Microsoft.AspNetCore.Components

<div>

    <div class="flex flex-center flex-spacebetween flow mgb-5">

        <div>
            <h5 class="mg-0 pdb fsz-15 cl-primary">
                Temperature Profile
            </h5>

            <p class="mg-0 fsz-10">
                Temperature variation along a selected grid line
            </p>
        </div>

        <div class="flex flex-center">

            <select class="pd bd corner-1 bg-card" value="@ProfileDirection" @onchange="OnDirectionChanged">
                <option value="Horizontal">Horizontal</option>
                <option value="Vertical">Vertical</option>
            </select>

            <select class="pd bd corner-1 bg-card" value="@SelectedIndex" @onchange="OnPositionChanged">
                @for (int i = 0; i < PositionCount; i++)
                {
                    <option value="@i">@GetPositionValue(i).ToString("F3")</option>
                }
            </select>

        </div>

    </div>

    <PlotlyChart @bind-Config="config" @bind-Data="data" @bind-Layout="layout" @ref="chart" Style="height: 400px;" />

</div>

@code {

    [Parameter]
    public double[][]? Temperature { get; set; }

    [Parameter]
    public int GridWidth { get; set; }

    [Parameter]
    public int GridHeight { get; set; }

    [Parameter]
    public double XMin { get; set; } = -1;

    [Parameter]
    public double XMax { get; set; } = 1;

    [Parameter]
    public double YMin { get; set; } = -1;

    [Parameter]
    public double YMax { get; set; } = 1;


    private string ProfileDirection { get; set; } = "Horizontal";

    private int SelectedIndex { get; set; }


    private Config config = new()
    {
        Responsive = true
    };

    private Layout layout = new();

    private IList<ITrace> data = new List<ITrace>();
    private PlotlyChart? chart;


    private int PositionCount =>
        ProfileDirection == "Horizontal"
            ? GridHeight
            : GridWidth;


    protected override void OnParametersSet()
    {
        if (SelectedIndex >= PositionCount)
            SelectedIndex = 0;

        data = BuildProfileData();

        layout = BuildLayout();
    }


    private IList<ITrace> BuildProfileData()
    {
        if (Temperature is null ||
            Temperature.Length == 0 ||
            GridWidth < 2 ||
            GridHeight < 2)
        {
            return new List<ITrace>();
        }

        var xValues = new List<object>();
        var temperatureValues = new List<object>();


        if (ProfileDirection == "Horizontal")
        {
            // Fixed Y, varying X

            int yIndex = Math.Clamp(
                SelectedIndex,
                0,
                GridHeight - 1);

            for (int x = 0; x < GridWidth; x++)
            {
                if (x >= Temperature[yIndex].Length)
                    continue;

                double coordinate =
                    XMin +
                    (XMax - XMin) *
                    x / (GridWidth - 1);

                xValues.Add(coordinate);
                temperatureValues.Add(Temperature[yIndex][x]);
            }
        }
        else
        {
            // Fixed X, varying Y

            int xIndex = Math.Clamp(
                SelectedIndex,
                0,
                GridWidth - 1);

            for (int y = 0; y < GridHeight; y++)
            {
                if (y >= Temperature.Length ||
                    xIndex >= Temperature[y].Length)
                    continue;

                double coordinate =
                    YMin +
                    (YMax - YMin) *
                    y / (GridHeight - 1);

                xValues.Add(coordinate);
                temperatureValues.Add(Temperature[y][xIndex]);
            }
        }


        return new List<ITrace>
        {
            new Scatter
            {
                X = xValues,
                Y = temperatureValues,
@* Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.LinesMarkers *@
                Mode = Plotly.Blazor.Traces.ScatterLib.ModeFlag.Lines
            }
        };
    }

    private Layout BuildLayout()
    {
        return new Layout
        {
            Title = new Plotly.Blazor.LayoutLib.Title
            {
                Text =
                    ProfileDirection == "Horizontal"
                        ? $"Temperature Profile at Y = {GetPositionValue(SelectedIndex):F3}"
                        : $"Temperature Profile at X = {GetPositionValue(SelectedIndex):F3}"
            },

            XAxis = new List<Plotly.Blazor.LayoutLib.XAxis>
        {
            new Plotly.Blazor.LayoutLib.XAxis
            {
                Title = new Plotly.Blazor.LayoutLib.XAxisLib.Title
                {
                    Text =
                        ProfileDirection == "Horizontal"
                            ? "X"
                            : "Y"
                }
            }
        },

            YAxis = new List<Plotly.Blazor.LayoutLib.YAxis>
        {
            new Plotly.Blazor.LayoutLib.YAxis
            {
                Title = new Plotly.Blazor.LayoutLib.YAxisLib.Title
                {
                    Text = "Temperature (K)"
                }
            }
        }
        };
    }


    private double GetPositionValue(int index)
    {
        if (ProfileDirection == "Horizontal")
        {
            if (GridHeight <= 1)
                return YMin;

            return YMin +
                   (YMax - YMin) *
                   index / (GridHeight - 1);
        }

        if (GridWidth <= 1)
            return XMin;

        return XMin +
               (XMax - XMin) *
               index / (GridWidth - 1);
    }


    private string GetPositionLabel(int index)
    {
        return ProfileDirection == "Horizontal"
            ? $"Y = {GetPositionValue(index):F3}"
            : $"X = {GetPositionValue(index):F3}";
    }

    private async Task OnDirectionChanged(ChangeEventArgs e)
    {
        ProfileDirection = e.Value?.ToString() ?? "Horizontal";
        SelectedIndex = 0;

        await UpdateProfile();
    }

    private async Task OnPositionChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var index))
        {
            SelectedIndex = index;
            await UpdateProfile();
        }
    }

    private async Task UpdateProfile()
    {
        data = BuildProfileData();
        layout = BuildLayout();

        if (chart is not null)
        {
            await chart.React();
        }
    }
}
