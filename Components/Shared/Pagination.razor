<div class="flex flex-spacebetween flow bg-card pd bd corner-1 shadow-border-1 mgt-5">

    <p class="fsz-12 mgb-3">
        Showing @FirstItemNumber–@LastItemNumber
        of @TotalItems @($"{ItemLabel}(s)")
    </p>

    <div class="flex flex-center">

        <button class="mdi mdi-arrow-left pd fsz-12 bg-transparent bd-none bd corner-1" disabled="@(CurrentPage == 1)"
                @onclick="PreviousPage">
        </button>

        @foreach (var page in VisiblePages)
        {
            if (page is null)
            {
                <span class="pd fsz-12">
                    ...
                </span>
            }
            else
            {
                var pageNumber = page.Value;

                <button
                    class="pd fsz-12 bg-transparent bd-none bd corner-1 @(CurrentPage == pageNumber ? "bg-primary cl-white" : "")"
                    @onclick="() => GoToPage(pageNumber)">
                    @pageNumber
                </button>
            }
        }

        <button class="mdi mdi-arrow-right pd fsz-12 bg-transparent bd-none bd corner-1"
                disabled="@(CurrentPage == TotalPages)" @onclick="NextPage">
        </button>

    </div>

</div>

@code {

    [Parameter]
    public int CurrentPage { get; set; }

    [Parameter]
    public int TotalPages { get; set; }

    [Parameter]
    public int TotalItems { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 10;

    [Parameter]
    public string ItemLabel { get; set; } = "item";

    [Parameter]
    public EventCallback<int> CurrentPageChanged { get; set; }

    private int FirstItemNumber =>
        TotalItems == 0
            ? 0
            : ((CurrentPage - 1) * PageSize) + 1;

    private int LastItemNumber =>
        Math.Min(
            CurrentPage * PageSize,
            TotalItems);

    private IEnumerable<int?> VisiblePages
    {
        get
        {
            if (TotalPages <= 5)
            {
                return Enumerable
                    .Range(1, TotalPages)
                    .Select(x => (int?)x);
            }

            var pages = new List<int?>();

            // Beginning
            if (CurrentPage <= 3)
            {
                pages.Add(1);
                pages.Add(2);
                pages.Add(3);
                pages.Add(null);
                pages.Add(TotalPages);

                return pages;
            }

            // End
            if (CurrentPage >= TotalPages - 2)
            {
                pages.Add(1);
                pages.Add(null);
                pages.Add(TotalPages - 2);
                pages.Add(TotalPages - 1);
                pages.Add(TotalPages);

                return pages;
            }

            // Middle
            pages.Add(1);
            pages.Add(null);
            pages.Add(CurrentPage);
            pages.Add(null);
            pages.Add(TotalPages);

            return pages;
        }
    }

    private async Task PreviousPage()
    {
        if (CurrentPage <= 1)
            return;

        await GoToPage(CurrentPage - 1);
    }

    private async Task NextPage()
    {
        if (CurrentPage >= TotalPages)
            return;

        await GoToPage(CurrentPage + 1);
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages)
            return;

        await CurrentPageChanged.InvokeAsync(page);
    }
}