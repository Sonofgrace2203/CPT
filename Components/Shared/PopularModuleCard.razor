<div class="bg-secondary-01 corner-2 bdl bd-success bdw-3 shadow-border-2 pd mgb">
    <div class="">
        <div class="flex flex-center">
            
            <div class="wf">
                <p class="mg-0 pdb fsz-13">@Tag</p>
                <h4 class="mg-0 fsz-17 cl-secondary">@Num</h4>
            </div>
            <img src="@Img" alt="" class="wx-05 hx-05 corner-2 mgb-3">
        </div>
    </div>
</div>

@code {
    [Parameter] public int Num { get; set; }
    [Parameter] public string Tag { get; set; } = "";
    [Parameter] public string Img { get; set; } = "";
}